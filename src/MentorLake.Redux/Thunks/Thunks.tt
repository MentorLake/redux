{
	public async Task ExecuteAsync(ThunkApi api)
	{
		try
		{
			api.Dispatch(new ThunkPending(actionName));
			var result = await work(api, <#=Repeat(i, "arg{i}")#>);
			api.Dispatch(new ThunkFulfilled<TResult>(actionName, result));

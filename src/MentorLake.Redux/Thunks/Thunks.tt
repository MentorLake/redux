{
	public CallableAsyncThunkArgOnly<<#=Repeat(i, "TArg{i}")#>> Bind(<#=Repeat(i, "TArg{i} arg{i}")#>) => new(actionName, work, <#=Repeat(i, "arg{i}")#>);
}

